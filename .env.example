# Copy this file to .env and fill in real values before going to production.

# Database (SQLite by default; swap for a Postgres URL later, e.g.
# postgresql+psycopg2://user:password@host:5432/crestview)
DATABASE_URL=sqlite:///./crestview.db

# --- SMTP / lead notification email -----------------------------------
# TODO: fill in with real outbound mail credentials before launch.
# Leaving SMTP_HOST blank disables email sending; leads are still saved
# to the database either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Address leads are sent "from" (often must match SMTP_USERNAME's domain).
SMTP_FROM_EMAIL=noreply@crestviewestates.com
# Address(es) the sales team reads. Comma-separate for multiple recipients.
LEAD_NOTIFICATION_EMAIL=hello@crestviewestates.com
